# Exclude development environments
.vscode/**
.vscode-test/**
.claude/**
scripts/**
tmp/**

# Exclude source code and maps
src/**
out/**/*.map
out/**/*.d.ts
out/view/webview/chart.js
out/sql-asm.js

# Exclude configuration files
.gitignore
.eslintrc.json
.eslintrc.js
.prettierrc
.editorconfig
tsconfig.json
package-lock.json
jest.config.js
.env.local

# Exclude docs directory and announcement source files (fetched via GitHub raw URL)
announcements*.json

assets/*
!assets/icon.png

# Exclude OS-specific files
.DS_Store
**/.DS_Store
Thumbs.db

# Exclude local build artifacts
*.vsix
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude node_modules (dependencies are bundled by esbuild)
node_modules/**
